rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /elections/6258 {
      allow read: if true;
      allow write: if false;
      match /partials/{partialId} {
        allow read: if true;
        allow write: if false;
      }
      match /regions/{region} {
        allow read: if true;
        allow write: if false;
        match /partials/{partialId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
